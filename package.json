{
  "name": "jellyfin-featured-plugin",
  "private": true,
  "type": "module",
  "version": "12.7.1.0",
  "description": "TypeScript and Vue frontend for the Jellyfin Featured plugin.",
  "scripts": {
    "typecheck": "tsc --noEmit && vue-tsc --noEmit",
    "bundle": "node scripts/build.mjs",
    "build": "npm run typecheck && npm run bundle",
    "test": "node --test tests/*.test.mjs",
    "dev": "vite --config vite.config.ts",
    "dev:bundle": "node scripts/build.mjs --watch",
    "i18n:status": "node scripts/update-i18n-status.mjs"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/compiler-sfc": "^3.5.38",
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.5"
  },
  "dependencies": {
    "vue": "^3.5.43",
    "vuedraggable": "^4.1.0"
  }
}
