{
  "name": "jellyfin-featured-plugin",
  "private": true,
  "type": "module",
  "version": "12.8.0.0",
  "description": "TypeScript and Vue frontend for the Jellyfin Featured plugin.",
  "scripts": {
    "format": "npm run format:web && npm run format:dotnet",
    "format:web": "prettier --write .",
    "format:dotnet": "dotnet format JellyfinFeatured.sln whitespace --no-restore",
    "format:check": "npm run format:check:web && npm run format:check:dotnet",
    "format:check:web": "prettier --check .",
    "format:check:dotnet": "dotnet format JellyfinFeatured.sln whitespace --no-restore --verify-no-changes",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit",
    "bundle": "node scripts/build.mjs",
    "build": "npm run format && npm run lint && npm run typecheck && npm run bundle",
    "test": "npm run test:unit && npm run test:contracts",
    "test:unit": "vitest run",
    "test:contracts": "node --test tests/*.test.mjs",
    "dev": "vite --config vite.config.ts",
    "dev:bundle": "node scripts/build.mjs --watch",
    "i18n:status": "node scripts/update-i18n-status.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.6",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "dependencies": {
    "vue": "^3.5.44",
    "vuedraggable": "^4.1.0"
  }
}
