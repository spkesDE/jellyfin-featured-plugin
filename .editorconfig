root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ts,mjs,js,json,vue,css,html,yml,yaml}]
indent_style = space
indent_size = 2

[*.{cs,csproj,sln,props,targets,ps1}]
indent_style = space
indent_size = 4

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
